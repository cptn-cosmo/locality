# Copy to .env and fill in. One block per location; the prefix is the id in upper case.
# Use single quotes for values with spaces, backslashes (regexes) or "|".
LOCATIONS=home

HOME_NAME=Example Town
HOME_SUBTITLE='Postcode · District, State'
HOME_LAT=0.0
HOME_LON=0.0
# Amtlicher Regionalschlüssel at district level (last 7 digits zeroed)
HOME_ARS=000000000000
HOME_RADIUS_KM=15
HOME_AUTOBAHNS=A1,A2
# Berlin VIZ roadworks (only useful in/around Berlin)
HOME_VIZ=false
# DWD pollen region_id/partregion_id (-1 = whole region)
HOME_POLLEN=0/-1
# Optional DWD station for current weather (default: nearest)
#HOME_WMO_STATION=
# Words that mark a feed item as local; /…/ is a regex
HOME_KEYWORDS='Example Town,Neighbouring Village,/\bXYZ\b/'
# Feeds: Name|url[|keywords], separated by ";". With keywords, the feed is matched
# against them ("*" = HOME_KEYWORDS); without, every item counts as local.
HOME_POLICE='Presseportal Blaulicht|https://www.presseportal.de/rss/polizei/r/Example.rss2; State police|https://example.org/police.rss|*'
HOME_NEWS='Regional news|https://example.org/news.rss|*,Region Name'
# Up to 2 stations for departure boards: [Label|]stop name or Transitous stop id, separated by ";"
HOME_STATIONS='Station|Example Town Bahnhof; Example Town Marktplatz'
# Optional transit disruption feeds, same format as HOME_NEWS
#HOME_TRANSIT='Operator updates|https://example.org/disruptions.rss'
